<resources>
    <!-- чёрное окно сразу при запуске, без серой вспышки и двойной заливки фона -->
    <style name="NtTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nt_black</item>
        <item name="android:colorAccent">@color/nt_white</item>
    </style>

    <style name="NtLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/nt_grey</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="NtSmall" parent="NtLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="NtBig">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/doto</item>
        <item name="android:textSize">38sp</item>
        <item name="android:textColor">@color/nt_white</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="NtMid" parent="NtBig">
        <item name="android:textSize">18sp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="NtBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitStart</item>
        <item name="android:src">@drawable/dot_bar</item>
    </style>

    <style name="NtButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/nt_button</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/nt_black</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NtInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/nt_input</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/nt_white</item>
        <item name="android:textColorHint">@color/nt_dim</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
